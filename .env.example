# Postgres (Neon, Supabase, o qualsiasi altro). Usa la connection string "pooled".
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Segreto per firmare il cookie di sessione. Genera con: npm run auth:secret
AUTH_SECRET=""

# Hash della tua password di accesso. Genera con: npm run auth:hash -- "la-tua-password"
AUTH_PASSWORD_HASH=""

# Token che la CLI di ingest usa per autenticarsi verso /api/ingest.
# Genera con: npm run auth:secret
INGEST_TOKEN=""

# Solo per la CLI locale: dove vive la dashboard.
# In locale: http://localhost:5173 — in produzione: https://tuo-dominio.vercel.app
BATTAFIT_URL="http://localhost:5173"
